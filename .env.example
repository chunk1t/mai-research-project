# Copy to .env and fill in. Never commit .env; never paste these into a chat.
#   cp .env.example .env

# Modal vLLM endpoint. Both are produced by `modal deploy` (build item 4),
# so leave them blank until the serving app is deployed.
# Modal serves ONE model per web endpoint, so each evaluated arm needs its own
# URL. `modal deploy` prints both. A single shared URL sends every GLM request
# to the Qwen server, which answers 404 and silently kills half the matrix.
MODAL_VLLM_URL_QWEN=
MODAL_VLLM_URL_GLM=
MODAL_VLLM_URL=
MODAL_VLLM_KEY=

# Google AI Studio, free tier. Case generator + RAGAS judge.
GOOGLE_API_KEY=

# Anthropic API (console.anthropic.com, separate from a Claude subscription).
# CRS judge + refusal classifier fallback.
ANTHROPIC_API_KEY=

# HuggingFace, free. Only needed if a weights repo is gated (GLM-4 may be).
# NOTE: Modal downloads the weights, not this machine, so this value must also
# be given to Modal as a secret:
#   modal secret create huggingface HF_TOKEN=hf_your_token_here
HF_TOKEN=
